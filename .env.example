# =============================================================================
# EN: Copy this file to `.env` and fill in your own values.
#     `.env` is ignored by git - never commit real keys.
# ES: Copie este archivo como `.env` y complete sus propios valores.
#     `.env` está ignorado por git - nunca suba claves reales.
# =============================================================================

# EN: Ollama Cloud API key (https://ollama.com/settings/keys). Required for the live AI.
#     Without it, use the "Rehearsal" button (recorded answers).
# ES: Clave de API de Ollama Cloud (https://ollama.com/settings/keys). Necesaria para la IA en vivo.
#     Sin ella, use el botón "Ensayo" (respuestas grabadas).
OLLAMA_API_KEY=

# EN: Optional - Ollama chat endpoint (use http://localhost:11434/api/chat for a local Ollama).
# ES: Opcional - endpoint de chat de Ollama (use http://localhost:11434/api/chat para Ollama local).
# OLLAMA_URL=https://ollama.com/api/chat

# EN: Optional - main model and fallback model.
# ES: Opcional - modelo principal y modelo de respaldo.
# DEMO_MODEL=gpt-oss:120b
# DEMO_FALLBACK_MODEL=glm-5.3-flash

# EN: Optional - seconds to wait for the AI before falling back to Rehearsal (plan B).
# ES: Opcional - segundos de espera de la IA antes de pasar al Ensayo (plan B).
# DEMO_AI_TIMEOUT=20

# EN: Optional - local port of the demo.
# ES: Opcional - puerto local de la demo.
# DEMO_PORT=8765
